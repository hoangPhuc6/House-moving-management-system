# Server
SERVER_PORT=8080

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=house_moving_db
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JWT (Tùy chọn)
# JWT_SECRET=your_jwt_secret_key
# JWT_EXPIRATION_MS=86400000


MAP_API_KEY= Tạo tài khoản trên goong và lấy api key

# Lưu trữ file đính kèm (MinIO). Để trống STORAGE_PROVIDER nếu chưa dùng: app vẫn chạy, chỉ API upload báo lỗi.
# Chạy MinIO: docker compose up -d minio (file backend/docker-compose.yml đọc 2 biến MINIO_ACCESS_KEY / MINIO_SECRET_KEY ở đây)
# Trang quản trị MinIO: http://localhost:9001
STORAGE_PROVIDER=MINIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_min_8_chars
MINIO_BUCKET=house-moving
